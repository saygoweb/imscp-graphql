{
    "name": "saygoweb/imscp-graphql",
    "description": "A GraphQL API for i-MSCP, delivered as a plugin",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Cambell Prince",
            "email": "cambell.prince@gmail.com"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4 <8.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "webonyx/graphql-php": "^15.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "slim/slim": "^3.12"
    },
    "autoload": {
        "psr-4": {
            "iMSCP\\Plugin\\SGW_GraphQL\\": ""
        },
        "exclude-from-classmap": [
            "/test/",
            "/tools/",
            "/frontend/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "iMSCP\\Plugin\\SGW_GraphQL\\Test\\Integration\\": "test/integration",
            "iMSCP\\Plugin\\SGW_GraphQL\\Test\\Authz\\": "test/authz",
            "iMSCP\\Plugin\\SGW_GraphQL\\Test\\": "test/"
        }
    },
    "scripts": {
        "schema": "@php tools/export-schema.php",
        "schema:check": "@php tools/export-schema.php --check",
        "schema:print": "@php tools/export-schema.php --stdout"
    },
    "scripts-descriptions": {
        "schema": "Regenerate test/schema/schema.printed.graphql, the SDL consumers build against",
        "schema:check": "Fail if that file is stale, without writing it",
        "schema:print": "Print the schema to stdout instead of writing it"
    }
}
